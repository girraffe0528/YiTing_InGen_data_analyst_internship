    <worksheet name='Permutation Feature Importance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>Wheel Imbalance Is the Strongest Predictor of Operational Mode</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Permutation importance measures the decrease in Macro-F1 after each feature is shuffled. Wheel imbalance has the highest importance (0.296), followed by the four wheel torque features and LiDAR distance, while all remaining features have minimal impact.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='W07_rf_feature_importance' name='federated.1tb9xh30ir9jrq1cftfi71iiz30j' />
