    <worksheet name='RF Confusion Matrix'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>Random Forest Most Often Confuses ALERT with PATROL</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>The Random Forest correctly classifies most observations across all four operational modes. The largest misclassification is ALERT predicted as PATROL (479 observations), followed by FAULT predicted as PATROL (322 observations).</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
