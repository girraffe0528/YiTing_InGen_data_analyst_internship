            <column caption='Motor Anomaly Count' datatype='integer' name='[Calculation_2673801218245009412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([motor_stat_flag])' />
            </column>
            <column caption='Battery Anomaly Count' datatype='integer' name='[Calculation_2673801218245144581]' role='measure' type='quantitative'>
