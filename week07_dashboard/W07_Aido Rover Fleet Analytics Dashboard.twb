    <worksheet name='Threshold Anomaly Flagging'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>Motor Thresholds Generate the Most Anomaly Flags</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Motor-related thresholds generate 15,954 anomaly observations, substantially more than battery-related thresholds (4,898). GPS, LiDAR, and IMU thresholds each flag 240 observations, reflecting differences in how the controlled fault types affect their associated sensor signals.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='W07_anomaly_markers' name='federated.00chd2j0gbsah719lpzps10va9fw' />
          </datasources>
