    <worksheet name='RF F1 Score by Class'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>Random Forest F1 Exceeds 0.86 Across All Operational Modes</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Random Forest achieves F1 scores above 0.86 for all four operational modes. CHARGING has the highest F1 score (0.996), while FAULT has the lowest (0.863), indicating greater classification difficulty for FAULT observations.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='W07_rf_f1_by_class' name='federated.0lsim8x1f4bdon1fok1ho0t4opxz' />
